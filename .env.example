# Ecovacs account
ECOVACS_ACCOUNT_ID=
ECOVACS_PASSWORD=
# Two-letter country code of the account (e.g. DE, US)
ECOVACS_COUNTRY_CODE=DE
# Index of the robot in the account (0-based)
ECOVACS_DEVICE_NUMBER=0

# Required: a fixed id for this app, so Ecovacs verifies it only once.
# Generate one with: openssl rand -hex 16
# Keep the same value when moving the container (e.g. to a NAS) to avoid re-verification.
ECOVACS_CLIENT_DEVICE_ID=

# Leave blank for Ecovacs. Use 'yeedi.com' for Yeedi devices.
ECOVACS_AUTH_DOMAIN=
